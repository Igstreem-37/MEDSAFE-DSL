# Passes every STATIC check (each declaration is individually within its
# limits) but is unsafe at RUNTIME: the bolus overlaps the continuous
# infusion of the same drug. Only the VM's runtime monitor can see this.
PATIENT p1 { WEIGHT: 70 kg; }
DRUG dopamine { MAX_RATE: 20 mg/hr; MAX_TOTAL: 150 mg; }

INFUSION base FOR p1 USING dopamine AT 12 mg/hr;
REPEAT bolus FOR p1 USING dopamine AT 12 mg/hr EVERY 6 hr UNTIL 24 hr OVER 1 hr;
