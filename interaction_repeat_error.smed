# Phase 3.2 error case: INTERACTION limits now cover REPEAT doses.
# Heparin infusion (5 mg/hr) + dopamine bolus (15 mg/hr) = 20 mg/hr > limit 18 mg/hr at t=0.
PATIENT p1 { WEIGHT: 70 kg; }
DRUG dopamine { MAX_RATE: 20 mg/hr; }
DRUG heparin  { MAX_RATE: 15 mg/hr; }

INTERACTION dopamine WITH heparin LIMIT 18 mg/hr;

INFUSION base FOR p1 USING heparin AT 5 mg/hr;
REPEAT bolus  FOR p1 USING dopamine AT 15 mg/hr EVERY 6 hr UNTIL 12 hr OVER 1 hr;
